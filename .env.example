# Buyer supplies credentials locally; never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
PORT=3747
HOST=127.0.0.1
# Required for Docker/non-local binding; callers send Authorization: Bearer <value>.
INTAKE_TOKEN=
INTAKE_CONFIG=config/service-business.json
INTAKE_DB_PATH=
# Opt in only with appropriate egress controls.
ENABLE_ENRICHMENT=false
# console | slack | email | webhook (one adapter at a time)
DELIVERY_MODE=console
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
# Email uses Resend; verify the sender domain with that provider.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
